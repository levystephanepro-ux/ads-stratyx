# --- Supabase (auth + base de données) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Clé service_role : UNIQUEMENT côté serveur (jamais exposée au navigateur).
# Sert au serveur MCP à lire/écrire les tokens sans passer par la session utilisateur.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- URL publique de l'APPLICATION (liens des e-mails, URL MCP, callbacks OAuth) ---
# En local : http://localhost:3000  |  En production : https://app.stratyxmedia.fr
# Jamais le site vitrine (stratyxmedia.fr, www.stratyxmedia.fr) : ces hôtes sont ignorés.
# Sur Vercel, ne pas la définir pour Preview : chaque aperçu utilise alors sa propre adresse (VERCEL_URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Sécurité MCP : token secret exigé pour appeler /api/mcp en mono-compte ---
# Génère-en un : node -e "console.log('mcp_'+require('crypto').randomBytes(24).toString('base64url'))"
# OBLIGATOIRE avant toute exposition publique (sinon accès libre à ton compte Ads).
MCP_SHARED_TOKEN=

# --- Mode de données Google Ads ---
# mock  = données factices, aucun accès Google Ads requis (par défaut, pour développer)
# live  = vrais appels à l'API Google Ads (nécessite les identifiants ci-dessous)
ADS_DATA_MODE=mock

# --- Google Ads API (requis uniquement en mode live) ---
# Version de l'API. Une SEULE source de vérité : on la change ici quand Google déprécie.
# À vérifier sur https://developers.google.com/google-ads/api/docs/release-notes
GOOGLE_ADS_API_VERSION=v23
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# Compte MCC "manager" qui chapeaute les comptes clients (facultatif au début).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Google Search Console ---
# mock = données demo | live = vrais appels API
SEARCH_CONSOLE_DATA_MODE=mock
# Refresh token avec scope webmasters.readonly.
# Si le même OAuth app que Google Ads, laisser vide → réutilise GOOGLE_ADS_REFRESH_TOKEN.
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# --- Usage interne (avant commercialisation) ---
# true = inscriptions et page tarifs fermées, seul l'owner consomme de l'IA.
STRATYX_INTERNAL_MODE=false
# Emails autorisés en plus de l'owner (séparés par des virgules), facultatif.
STRATYX_ALLOWED_EMAILS=
# Plafond mensuel du coût IA de l'owner, en euros (converti en $ avec EUR_TO_USD, 1,15 par défaut).
# 0 = IA coupée. Alternative : OWNER_MONTHLY_BUDGET_USD.
OWNER_MONTHLY_BUDGET_EUR=5

# --- Waste Detector (cron /api/cron/waste, 0 crédit IA) ---
# CPA cible en euros pour le niveau "à surveiller" (sinon CPA moyen du compte).
WASTE_TARGET_CPA=

# --- Mail de confirmation envoyé au prospect après une demande sur /zone (toutes facultatives) ---
# Expéditeur : PROSPECT_EMAIL_FROM, sinon AGENT_EMAIL_FROM (domaine vérifié dans Resend).
# PROSPECT_EMAIL_FROM="Stéphane Levy <stephane@stratyxmedia.fr>"
# Adresse de contact affichée dans le mail (lien mailto: en HTML). Par défaut : contact@stratyxmedia.fr.
# PROSPECT_CONTACT_EMAIL=contact@stratyxmedia.fr
# Adresse de réponse (reply-to) : PROSPECT_REPLY_TO, sinon PROSPECT_CONTACT_EMAIL, sinon contact@stratyxmedia.fr,
# sinon AGENT_EMAIL_TO en dernier recours. Cette dernière n'est jamais écrite dans le corps du mail.
# PROSPECT_REPLY_TO=contact@stratyxmedia.fr
